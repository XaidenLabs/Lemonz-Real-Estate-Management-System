{
  "expo": {
    "name": "Lemonz",
    "slug": "lemon-zee",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "scheme": "acme",
    "icon": "./assets/common/logo_square.jpg",
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-document-picker",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Lemonz to use your location."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Lemonz to access your camera to scan ID documents."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "android": {
      "package": "com.oftotech.lemonz",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/common/logo_square.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "ios": {
      "bundleIdentifier": "com.oftotech.lemonz",
      "buildNumber": "1.0.0",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Lemonz to access your camera to scan ID documents.",
        "NSLocationWhenInUseUsageDescription": "Allow Lemonz to use your location.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow Lemonz to use your location.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e1f53dfd-47b1-4883-8823-d439dff703d0"
      }
    },
    "owner": "xaiden"
  }
}
